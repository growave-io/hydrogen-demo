{
  "name": "hydrogen-demo",
  "private": true,
  "version": "0.1.0",
  "description": "Minimal Shopify Hydrogen storefront showing how to integrate Growave widgets with @growave-io/react-sdk",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/growave-io/hydrogen-demo.git"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "shopify hydrogen build --codegen --disable-route-warning",
    "dev": "node scripts/dev.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "preview": "shopify hydrogen preview --build --port 3081",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "start": "node node-server.mjs"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@growave-io/react-sdk": "^0.4.0",
    "@shopify/hydrogen": "2026.4.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.22",
    "lucide-react": "^1.52.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router": "7.16.0",
    "react-router-dom": "7.16.0",
    "sugar-high": "^2.6.0",
    "tailwindcss": "^4.1.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@react-router/dev": "7.16.0",
    "@react-router/fs-routes": "7.16.0",
    "@shopify/cli": "3.93.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.2.3",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "prettier": "^3.4.2",
    "shadcn": "^4.21.4",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "zod": "^4.6.6"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ],
  "overrides": {
    "use-resize-observer": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "lodash": "^4.18.1"
  }
}
