# Store profile for a storefront in the Headless sales channel.
# Copy to envs/<store>.env and run `STORE=<store> npm run dev`.
# Every value comes from Shopify admin → Sales channels → Headless → your storefront.
# Required variables are set; uncomment an optional one to use it.

SALES_CHANNEL="headless"

# Required. The store's permanent *.myshopify.com domain, the one it was created with.
# A renamed store keeps it (Settings → Domains), and Growave identifies the shop by it.
PUBLIC_STORE_DOMAIN=""

# Required. Storefront API → Public access token. It needs the
# unauthenticated_read_product_listings, _product_inventory and _product_tags permissions.
PUBLIC_STOREFRONT_API_TOKEN=""

# Optional. Storefront API → Private access token, used only for server-side requests.
# PRIVATE_STOREFRONT_API_TOKEN=""

# Required. Any random string, used to sign the session cookie: `openssl rand -hex 32`.
SESSION_SECRET=""

# Optional. Domain the checkout runs on, usually the store's primary domain.
# PUBLIC_CHECKOUT_DOMAIN=""

# Optional. Customer login: Customer Account API → Client ID and the shop ID from
# its endpoints (https://shopify.com/<shop id>/...). Login also needs a public HTTPS URL:
# run `npm run tunnel` and register the URLs it prints (see "Customer login" in the README).
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
# PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
# SHOP_ID=""

# Optional. Growave admin → Settings → API. Server-only; signs logged-in customers for
# Growave. Without it customers stay guests in the widgets.
# PRIVATE_GROWAVE_API_SECRET=""

# Optional. Growave admin → Instagram → gallery ID. Without it the galleries are hidden.
# PUBLIC_GROWAVE_INSTAGRAM_GALLERY_ID=""
