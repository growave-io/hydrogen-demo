# Default profile for `npm run dev`: Growave's public demo store, so the widgets work right away.
# It holds only values that every visitor's browser receives anyway: the store domain,
# the public Storefront API token and the Instagram gallery ID. Customer login and
# Growave customer authentication need secrets, so they are off here; use your own
# profile (see envs/headless_example.env or envs/hydrogen_example.env) to try them.
SALES_CHANNEL="headless"
PUBLIC_STORE_DOMAIN="ssw-demo.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN="4a17e120ac78e1f82c7cfda0f66e39cc"
PUBLIC_CHECKOUT_DOMAIN="growave-demo-public.myshopify.com"
# Local development only. Set your own value in any profile you deploy.
SESSION_SECRET="hydrogen-demo-local-only"
PUBLIC_GROWAVE_INSTAGRAM_GALLERY_ID="82"
