# Store profile for hydrogen-demo.
# Copy to envs/<store>.env and run `STORE=<store> npm run dev`.
# Every file in envs/ except this one is git-ignored.

# Required. The store's *.myshopify.com domain.
PUBLIC_STORE_DOMAIN=""

# Required. Public Storefront API access token
# (Shopify admin → Sales channels → Headless or Hydrogen → your storefront → Storefront API).
PUBLIC_STOREFRONT_API_TOKEN=""

# Required. Any random string, used to sign the session cookie.
SESSION_SECRET=""

# Domain the checkout runs on, usually the store's primary domain. Used for the content security policy.
PUBLIC_CHECKOUT_DOMAIN=""

# Optional. Storefront ID for analytics (Headless or Hydrogen channel → Storefront API).
PUBLIC_STOREFRONT_ID=""

# Optional. Customer login (Customer Account API).
# Headless or Hydrogen channel → Customer Account API settings / Storefront settings.
# Login also needs a public HTTPS domain: run `STORE=<store> npm run store:link`
# once for a Hydrogen channel storefront, and `npm run dev` starts a tunnel for it.
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
SHOP_ID=""
